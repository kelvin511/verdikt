{
  "name": "verdikt",
  "version": "0.1.0",
  "description": "Turn your git history into readable Architectural Decision Records — local-first, no cloud, works on any repo.",
  "type": "module",
  "bin": {
    "verdikt": "./dist/index.js"
  },
  "files": [
    "dist",
    "dashboard-dist"
  ],
  "license": "MIT",
  "keywords": [
    "adr",
    "architectural-decision-records",
    "git",
    "cli",
    "documentation",
    "changelog"
  ],
  "homepage": "https://github.com/kelvin511/verdikt#readme",
  "bugs": {
    "url": "https://github.com/kelvin511/verdikt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelvin511/verdikt.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "node scripts/check-dashboard-built.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "gray-matter": "^4.0.3",
    "ora": "^8.1.0",
    "prompts": "^2.4.2",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.7.0"
  }
}
