# Copy this file to .env and fill in whichever provider(s) you want to use
# with `verdikt scan --ai`. verdikt loads .env automatically from the
# directory you run it in — nothing else needs to be configured.
#
# You only need ONE of these. If more than one is set, this is the
# preference order verdikt checks (free-tier-friendly first):
#   1. OpenRouter
#   2. Google Gemini
#   3. Anthropic Claude
# Force a specific one regardless of what's set with --provider or
# VERDIKT_AI_PROVIDER below.

# OpenRouter — free-tier models available. Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini — free tier. Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_API_KEY= # alternative name for the same thing, either works

# Anthropic Claude — paid. Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
# VERDIKT_AI_PROVIDER=openrouter   # force a provider instead of auto-detecting: anthropic | openrouter | google
# VERDIKT_MODEL=                   # override the default model for whichever provider is active
